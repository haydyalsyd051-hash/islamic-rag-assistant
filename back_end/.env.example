# انسخي هذا الملف إلى .env واملأي القيم الحقيقية
# Copy this file to .env and fill in real values

# مفتاح Anthropic API (لتوليد الإجابات النهائية عبر Claude)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# نموذج Claude المستخدم للتوليد
ANTHROPIC_MODEL= qwen2.5:3b

# مسارات ملفات الفهرس (الناتجة من خلية الـ Export في notebooks/rag_pipeline.ipynb)
# نسبية لمجلد تشغيل الـ backend افتراضيًا — عدّليها لو الملفات في مكان مختلف
VECTOR_STORE_DIR=data\processed\faiss_index
DOCS_PICKLE_PATH=data\processed\all_docs.pkl

# نموذج الـ Embeddings — لازم يطابق بالضبط النموذج المستخدم وقت بناء الفهرس في الـ Notebook
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# إعدادات الاسترجاع (Hybrid: BM25 + Vector)
RETRIEVAL_TOP_K=6
RETRIEVAL_INTERNAL_K=8
BM25_WEIGHT=0.45
VECTOR_WEIGHT=0.55

# نطاقات CORS المسموح بها، مفصولة بفاصلة
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
